; Production MD template
integrator               = md
dt                       = 0.002
nsteps                   = {NSTEPS}

nstxout-compressed       = 5000
nstcalcenergy            = 100
nstenergy                = 1000
nstlog                   = 1000

cutoff-scheme            = Verlet
nstlist                  = 20
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
vdw-modifier             = None
DispCorr                 = EnerPres
rvdw                     = 1.0
rlist                    = 1.0
pbc                      = xyz

tcoupl                   = v-rescale
tc-grps                  = {TC_GRPS}
tau-t                    = 1.0 1.0
ref-t                    = {TEMP} {TEMP}

pcoupl                   = Parrinello-Rahman
pcoupltype               = {PCOUPL_TYPE}
tau-p                    = 5.0
ref-p                    = {REF_P}
compressibility          = {COMPRESSIBILITY}

constraints              = h-bonds
constraint-algorithm     = LINCS
continuation             = yes
lincs-order              = 4
lincs-iter               = 1

nstcomm                  = 100
comm-mode                = linear
comm-grps                = {TC_GRPS}
gen_vel                  = no